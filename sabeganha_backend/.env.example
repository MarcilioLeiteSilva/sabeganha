# -------------------------------------------------------------
# SABEGANHA BACKEND - ENVIRONMENT VARIABLES
# -------------------------------------------------------------

# Application
PORT=3000
NODE_ENV=development
APP_NAME=SabeGanha-Core-API
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://sabeganha_admin:sabeganha_secret_2026@localhost:5432/sabeganha_db?schema=public"

# Redis & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=sabeganha_redis_secret

# Security & JWT
JWT_ACCESS_SECRET=super_secret_jwt_access_key_sabeganha_2026_change_me
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_sabeganha_2026_change_me
JWT_REFRESH_EXPIRATION=30d

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Google AdMob SSV
ADMOB_VERIFY_KEY_URL=https://www.gstatic.com/admob/reward/verifier-keys.json

# Storage (S3 / Cloudflare R2)
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=sabeganha-assets
S3_PUBLIC_URL=https://assets.sabeganha.com.br

